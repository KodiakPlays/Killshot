  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 2a399ced64b134d65a0ff1f3a79ec2ce, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Mission
  goal: 6
  help: 'COLD RUN. Your weapons are off. Reach the JUMP POINT at the far end of the
    corridor. The Garuda patrols the corridor. If it finds you, it hunts you.


    1.
    Press P. POWER (key 3): click ENG and SEN to DRAW.


    2. ORDERS: click the
    alert once, from C3 to C2.


    3. SENSORS (key 2): turn on DRADIS. Watch the
    Garuda''s path.


    4. Fly with W, A and D. Less power means less signal.


    5.
    Move from gas cloud to gas cloud. Inside a cloud your signal falls. Rocks block
    its sensors.


    6. Reach the ring: level won.'
  drill: []
  jumpPoint: {fileID: 512656249}
  weaponsOff: 1
