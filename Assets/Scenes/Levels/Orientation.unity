--- !u!114 &2102863447
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2102863446}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 2a399ced64b134d65a0ff1f3a79ec2ce, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Mission
  goal: 5
  help: 
  drill:
  - check: 0
    amount: 3
    ringAt: {x: 0, y: 0}
    ringUnits: 0
    mapUnits: 0
    note: "COMMAND \xB7 WELCOME, COMMANDER.\nA quick mop-up patrol. Standard thing.
      First, the orientation checklist.\n\nPOWER. Press P to start the clock. Press
      3 to open Power. Click the ENG selector to DRAW. At ENG 2, click it again.
      STANDBY keeps the units."
  - check: 2
    amount: 0
    ringAt: {x: 0, y: -2450}
    ringUnits: 150
    mapUnits: 0
    note: "COMMAND \xB7 THROTTLE.\nW raises the throttle. S lowers it. Below 0 is
      reverse. ENG sets the limit.\n\nThe group is under way. Keep station in the
      middle of the formation. Fly into the CHECKPOINT ring ahead."
  - check: 2
    amount: 0
    ringAt: {x: 700, y: -2250}
    ringUnits: 150
    mapUnits: 0
    note: "COMMAND \xB7 HEADING.\nA turns to port. D turns to starboard. Hold the
      key to swing further.\n\nThe alarm strip gives the checkpoint's bearing. Turn
      onto it and fly there."
  - check: 4
    amount: 3
    ringAt: {x: 0, y: 0}
    ringUnits: 0
    mapUnits: 0
    note: "COMMAND \xB7 SIDE THRUSTERS.\nHold Q. The ship slides to port. The nose
      stays where it is. Let go and the drift fades.\n\nHold it for 3 seconds."
  - check: 5
    amount: 3
    ringAt: {x: 0, y: 0}
    ringUnits: 0
    mapUnits: 0
    note: "COMMAND \xB7 SIDE THRUSTERS.\nHold E. The ship slides to starboard.\n\nHold
      it for 3 seconds."
  - check: 6
    amount: 0.2
    ringAt: {x: 0, y: 0}
    ringUnits: 0
    mapUnits: 0
    note: "COMMAND \xB7 ZOOM.\nWith the mouse on the plot, roll the wheel to zoom
      out to x0.20 or less. The SCALE box shows the zoom.\n\nYou'll see the group
      round you, and the edge of the patrol area."
  - check: 7
    amount: 0.8
    ringAt: {x: 0, y: 0}
    ringUnits: 0
    mapUnits: 0
    note: "COMMAND \xB7 ZOOM.\nZoom out to see far. Zoom in to see close.\n\nRoll
      the wheel back to x0.80 or more."
  - check: 6
    amount: 0.12
    ringAt: {x: 0, y: 0}
    ringUnits: 0
    mapUnits: 16000
    note: "COMMAND \xB7 PATROL AREA OPEN.\nFlight checks done. The patrol area is
      bigger now.\n\nZoom out to x0.12 or less and look."
  - check: 8
    amount: 0
    ringAt: {x: 0, y: 0}
    ringUnits: 0
    mapUnits: 0
    note: "COMMAND \xB7 SENSORS.\nDRADIS hears ships.\n\nPress 3 and put SEN on DRAW.
      Press 2 and switch DRADIS on."
  - check: 10
    amount: 0
    ringAt: {x: 0, y: 0}
    ringUnits: 0
    mapUnits: 0
    note: "COMMAND \xB7 ACTIVE SCAN.\nA ping names the ships in the cone, and shows
      rocks past your visual ring. It also makes you loud.\n\nSwitch ACTIVE SCAN
      on."
  - check: 11
    amount: 1
    ringAt: {x: 0, y: 0}
    ringUnits: 0
    mapUnits: 0
    note: "COMMAND \xB7 SENSOR CHECK.\nA ship you haven't scanned shows as a BOGEY.\n\nDrag
      the cone dial onto one of the ships near you. When the sweep passes it, its
      name shows in blue."
  - check: 6
    amount: 0.08
    ringAt: {x: 0, y: 6800}
    ringUnits: 250
    mapUnits: 24000
    note: "COMMAND \xB7 TAKE POINT.\nThat's the group: INDRA, VARUNA and MARUT. Sensors
      checked. The patrol area is open to the target zone.\n\nYou take point. The
      group holds south of the rock field. Zoom out to x0.08 or less: the target
      zone is north."
  - check: 1
    amount: 5
    ringAt: {x: 0, y: 6800}
    ringUnits: 250
    mapUnits: 0
    note: "COMMAND \xB7 MORE POWER.\nENG gives speed, acceleration and turn rate.\n\nPress
      3. Click the ENG selector until it reads DRAW. It steps through VENT on the
      way. Take ENG to 5."
  - check: 3
    amount: 45
    ringAt: {x: 0, y: 6800}
    ringUnits: 250
    mapUnits: 0
    note: "COMMAND \xB7 FULL THROTTLE.\nHold W until the throttle is at 100. More
      power makes the ship louder.\n\nHead for the checkpoint. Its bearing is on
      the alarm strip."
  - check: 2
    amount: 0
    ringAt: {x: 0, y: 6800}
    ringUnits: 250
    mapUnits: 0
    note: "COMMAND \xB7 ROCK FIELD.\nFly through to the checkpoint. A rock costs
      you armour.\n\nROCK AHEAD on the alarm strip counts the seconds to a hit. Slow
      down with S. Q and E shift you between rocks."
  - check: 9
    amount: 2
    ringAt: {x: 0, y: 9000}
    ringUnits: 300
    mapUnits: 0
    note: "COMMAND \xB7 TARGET ZONE.\nStop inside the ring, at the edge of the target
      zone. S lowers the throttle. The ship takes time to slow, so start early."
  jumpPoint: {fileID: 0}
  weaponsOff: 1
  groupRoute:
  - {x: 0, y: -1000}
  - {x: -1500, y: 1000}
  - {x: 0, y: 2800}
