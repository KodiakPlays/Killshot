--- !u!114 &2102863447
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2102863446}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 2a399ced64b134d65a0ff1f3a79ec2ce, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Mission
  goal: 5
  help: 
  drill:
  - check: 0
    amount: 3
    track: 
    weaponsFree: 0
    ringAt: {x: 0, y: 0}
    ringUnits: 0
    mapUnits: 0
    note: "COMMAND \xB7 Commander, this is Flagship. Form up astern for the station
      approach.\n\nPOWER \xB7 Press P to unpause. Press 3 to open Power. Click ENG
      to DRAW. At ENG 2, click again for STANDBY."
  - check: 2
    amount: 0
    track: 
    weaponsFree: 0
    ringAt: {x: -1650, y: -2950}
    ringUnits: 150
    mapUnits: 0
    note: "COMMAND \xB7 We're under way. Match our speed on the approach.\n\nHELM
      \xB7 Hold W to raise throttle. S lowers it. Fly into the CHECKPOINT ring ahead."
  - check: 2
    amount: 0
    track: 
    weaponsFree: 0
    ringAt: {x: 300, y: -2000}
    ringUnits: 150
    mapUnits: 0
    note: "COMMAND \xB7 Come round onto our course, Commander. Take your place astern.\n\nHELM
      \xB7 Read the CHECKPOINT bearing on the alarm strip. A turns to port. D turns
      to starboard. Steer into the ring."
  - check: 4
    amount: 3
    track: 
    weaponsFree: 0
    ringAt: {x: 0, y: 0}
    ringUnits: 0
    mapUnits: 0
    note: "COMMAND \xB7 Let's check your side thrusters before we reach the rocks.
      Ease out to port. Hold your heading.\n\nHELM \xB7 Keep ENG powered. Hold Q
      for 3 game seconds to slide to port."
  - check: 5
    amount: 3
    track: 
    weaponsFree: 0
    ringAt: {x: 0, y: 0}
    ringUnits: 0
    mapUnits: 0
    note: "COMMAND \xB7 Come back to starboard.\n\nHELM \xB7 Hold E for 3 game seconds
      to slide to starboard."
  - check: 6
    amount: 0.2
    track: 
    weaponsFree: 0
    ringAt: {x: 0, y: 0}
    ringUnits: 0
    mapUnits: 0
    note: "COMMAND \xB7 Widen your plot until you can see the whole formation.\n\nPLOT
      \xB7 Put the pointer over the plot. Roll the wheel to zoom out until SCALE
      reads x0.20 or less."
  - check: 7
    amount: 0.8
    track: 
    weaponsFree: 0
    ringAt: {x: 0, y: 0}
    ringUnits: 0
    mapUnits: 0
    note: "COMMAND \xB7 Bring the plot back in. Check your spacing on the flagship.\n\nPLOT
      \xB7 With the pointer over the plot, roll the wheel to zoom in to x0.80 or
      more."
  - check: 6
    amount: 0.12
    track: 
    weaponsFree: 0
    ringAt: {x: 0, y: 0}
    ringUnits: 0
    mapUnits: 16000
    note: "COMMAND \xB7 Here's the next stretch of the approach. Take a look before
      we enter the rocks.\n\nPLOT \xB7 The chart now covers a wider area. Zoom out
      to x0.12 or less."
  - check: 8
    amount: 0
    track: 
    weaponsFree: 0
    ringAt: {x: 0, y: 0}
    ringUnits: 0
    mapUnits: 0
    note: "COMMAND \xB7 Start listening, Commander. Let's see who else is using this
      approach.\n\nSENSORS \xB7 Press 3 to open Power. Set SEN to DRAW. Press 2 to
      open Sensors and switch DRADIS on."
  - check: 10
    amount: 0
    track: 
    weaponsFree: 0
    ringAt: {x: 0, y: 0}
    ringUnits: 0
    mapUnits: 0
    note: "COMMAND \xB7 Ping the formation.\n\nSENSORS \xB7 Switch ACTIVE SCAN on.
      Other ships can hear your ping."
  - check: 11
    amount: 1
    track: 
    weaponsFree: 0
    ringAt: {x: 0, y: 0}
    ringUnits: 0
    mapUnits: 0
    note: "COMMAND \xB7 Pick a ship in the group. See if you can put a name to that
      contact.\n\nSENSORS \xB7 Aim the scan cone at a BOGEY with the cone dial. Keep
      it there until the sweep crosses the ship and its name appears."
  - check: 1
    amount: 5
    track: 
    weaponsFree: 0
    ringAt: {x: 300, y: 1900}
    ringUnits: 250
    mapUnits: 24000
    note: "COMMAND \xB7 The group is heading for the station. Bring your engines
      up, Commander.\n\nPOWER \xB7 Press 3. Click ENG until it reads DRAW. Take ENG
      to 5."
  - check: 3
    amount: 45
    track: 
    weaponsFree: 0
    ringAt: {x: 300, y: 1900}
    ringUnits: 250
    mapUnits: 0
    note: "COMMAND \xB7 Close up on us.\n\nHELM \xB7 Hold W until the throttle is
      at 100. More power makes the ship louder."
  - check: 2
    amount: 0
    track: 
    weaponsFree: 0
    ringAt: {x: 300, y: 1900}
    ringUnits: 250
    mapUnits: 0
    note: "COMMAND \xB7 We'll go round the rocks. You take the short way through.\n\nHELM
      \xB7 Fly into the CHECKPOINT ring. Its bearing is on the alarm strip."
  - check: 9
    amount: 2
    track: 
    weaponsFree: 0
    ringAt: {x: 0, y: 5900}
    ringUnits: 300
    mapUnits: 0
    note: "COMMAND \xB7 The station is north, past the rocks. Meet us there.\n\nHELM
      \xB7 ROCK AHEAD on the alarm strip counts the seconds to a hit. Slow down with
      S. Q and E shift you between rocks. Stop inside the ring at the station."
  - check: 11
    amount: 0
    track: s1
    weaponsFree: 0
    ringAt: {x: 0, y: 0}
    ringUnits: 0
    mapUnits: 0
    note: "COMMAND \xB7 Station traffic control isn't answering. Ping the station.\n\nSENSORS
      \xB7 Switch ACTIVE SCAN on. Hold the cone on the station until its name appears."
  - check: 12
    amount: 4
    track: 
    weaponsFree: 0
    ringAt: {x: 0, y: 0}
    ringUnits: 0
    mapUnits: 0
    note: "COMMAND \xB7 Hull breach confirmed. Escape pods in the wreckage. DRADIS
      has a faint contact. Increase gain.\n\nSENSORS \xB7 Press 3 and bring SEN to
      4. Press 2 and raise GAIN to 4."
  - check: 11
    amount: 0
    track: p1
    weaponsFree: 0
    ringAt: {x: 0, y: 0}
    ringUnits: 0
    mapUnits: 0
    note: "COMMAND \xB7 Contact east of the station. Ping it for identification.\n\nSENSORS
      \xB7 Keep ACTIVE SCAN on. Move the cone from the station to the red contact.
      Hold it there until the ship's name appears."
  - check: 13
    amount: 1
    track: 
    weaponsFree: 1
    ringAt: {x: 0, y: 0}
    ringUnits: 0
    mapUnits: 0
    note: "COMMAND \xB7 Pirate corvette, moving away. Pursue immediately, Captain.
      Torpedoes only. We'll recover the pods.\n\nORDERS \xB7 Set Condition 2 to release
      weapons."
  - check: 14
    amount: 0
    track: p1
    weaponsFree: 0
    ringAt: {x: 0, y: 0}
    ringUnits: 0
    mapUnits: 0
    note: "COMMAND \xB7 Get a lock on it.\n\nFIRE CONTROL \xB7 Lock the corvette
      with the targeting computer. Keep ENG high to keep up. Take SEN back down to
      1 to free power."
  - check: 16
    amount: 0
    track: p1
    weaponsFree: 0
    ringAt: {x: 0, y: 0}
    ringUnits: 0
    mapUnits: 0
    note: "COMMAND \xB7 Torpedoes. Knock out its engines.\n\nFIRE CONTROL \xB7 Give
      WEP 2. Pick TORPEDO. Set the four switches and pull the lever. Torpedoes reach
      3,000."
  - check: 17
    amount: 0
    track: p1
    weaponsFree: 0
    ringAt: {x: 0, y: 0}
    ringUnits: 0
    mapUnits: 0
    note: "COMMAND \xB7 The corvette has lost propulsion. Send the marines. Take
      the pirate captain alive.\n\nHANGAR \xB7 Give AUX 2. Launch the assault boats
      on SECURE. Stay close."
  - check: 18
    amount: 20
    track: 
    weaponsFree: 0
    ringAt: {x: 0, y: 0}
    ringUnits: 0
    mapUnits: 0
    note: "COMMAND \xB7 The boarding party has the pirate captain. Bring the prisoner
      aboard. We'll hear what the captain knows."
  jumpPoint: {fileID: 0}
  weaponsOff: 1
  railgunOff: 1
  groupRoute:
  - {x: -1200, y: 1800}
  - {x: -3000, y: 4000}
  - {x: -2600, y: 6200}
