  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::ShipRooms
  rooms:
  - name: BRIDGE
    view: {fileID: 997668015}
    tab: {fileID: 2136198300}
    people:
    - name: XO
      picture: {fileID: 1473723781}
      lines:
      - text: Captain on the bridge. All stations report ready.
        replies:
        - text: ANY NEWS?
          next: 1
        - text: CARRY ON.
          next: -1
      - text: Nothing new on the comms, Captain. The next target is on the sector
          map.
        replies:
        - text: CARRY ON.
          next: -1
  - name: ENGINEERING
    view: {fileID: 1999593654}
    tab: {fileID: 1828440025}
    people:
    - name: CHIEF ENGINEER
      picture: {fileID: 1890999534}
      lines:
      - text: The engines are cold and the reactor is steady, Captain. The crews
          are standing by.
        replies:
        - text: STAND BY.
          next: -1
  - name: HANGAR
    view: {fileID: 509427005}
    tab: {fileID: 1560499493}
    people:
    - name: FLIGHT LEADER
      picture: {fileID: 559134620}
      lines:
      - text: Every fighter is fuelled and armed. The pilots are ready when you are.
        replies:
        - text: GOOD.
          next: -1
  - name: QUARTERS
    view: {fileID: 1271186059}
    tab: {fileID: 1544557079}
    people:
    - name: MARINE SERGEANT
      picture: {fileID: 1047275686}
      lines:
      - text: The marines are resting, Captain. They will be ready for the next boarding.
        replies:
        - text: CARRY ON.
          next: -1
